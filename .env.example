DATABASE_URL=postgresql+psycopg://agente:agente@localhost:5432/agente
UMBRAL_CONFIANZA=0.80
GROQ_API_KEY=your_groq_api_key
GROQ_MODELO=openai/gpt-oss-20b
DIRECTORIO_FACTURAS=./facturas
FUENTE_CATALOGO=bd
# Firma de los tokens JWT: obligatorio, al menos 32 caracteres. Genérelo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_MINUTOS=60
# Orígenes del navegador que pueden llamar la API, separados por comas. Vacío: ninguno.
CORS_ORIGENES=
# /carpeta/procesar solo acepta carpetas dentro de este directorio (por defecto, DIRECTORIO_FACTURAS).
DIRECTORIO_ENTRADA=./facturas
# Tamaño máximo de un documento de factura, en MB (API y recepción automática).
TAMANO_MAXIMO_DOCUMENTO_MB=10
# Recepción automática (RF01): carpetas de destino (por defecto, dentro de DIRECTORIO_ENTRADA).
DIRECTORIO_RECIBIDOS=./facturas/recibidos
DIRECTORIO_NO_RECIBIDOS=./facturas/no_recibidos
# Reintentos ante archivo bloqueado/incompleto o base sin respuesta, con espera creciente (1, 2, 4... s).
RECEPCION_REINTENTOS=3
RECEPCION_ESPERA_INICIAL=1
# Segundos que un archivo debe dejar de cambiar para considerar terminada su copia.
RECEPCION_ESPERA_ESTABILIDAD=1
